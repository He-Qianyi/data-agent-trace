    {
      "unit_id": "U00006",
      "operations": [
        {
          "type": "filtering",
          "phase": "submitted_for_execution",
          "description": "提交遍历 context/fees.json 的记录，按 account_type 为 null 或列表包含 'R'、且 aci 为 null 或列表包含 'B' 的条件收集匹配记录的 ID 并打印。",
          "basis": "explicit",
          "evidence": [
            {
              "evidence_id": "E00014",
              "quote": "with open('context/fees.json') as f:"
            },
            {
              "evidence_id": "E00014",
              "quote": "if ac is None:\n        ac_match = True  # null means all"
            },
            {
              "evidence_id": "E00014",
              "quote": "if aci is None:\n        aci_match = True  # null means all"
            },
            {
              "evidence_id": "E00014",
              "quote": "if ac_match and aci_match:\n        matches.append(entry['ID'])"
