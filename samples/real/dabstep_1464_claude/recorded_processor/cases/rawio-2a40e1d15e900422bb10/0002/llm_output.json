                {
                  "evidence_id": "E00014",
                  "quote": "print('Total count:', len(matches))"
                }
              ]
            }
          ],
          "requirement_links": [
            {
              "requirement_id": "R0001",
              "relation": "targets",
              "evidence": [
                {
                  "evidence_id": "E00014",
                  "quote": "if ac_match and aci_match:\n        matches.append(entry['ID'])"
