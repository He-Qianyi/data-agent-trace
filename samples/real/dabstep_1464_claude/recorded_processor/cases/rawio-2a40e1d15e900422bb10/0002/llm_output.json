              "description": "逐条读取 context/fees.json 的 data 列表，使用 entry 的 account_type、aci 与 ID 字段。",
              "basis": "explicit",
              "evidence": [
                {
                  "evidence_id": "E00014",
                  "quote": "ac = entry.get('account_type')"
