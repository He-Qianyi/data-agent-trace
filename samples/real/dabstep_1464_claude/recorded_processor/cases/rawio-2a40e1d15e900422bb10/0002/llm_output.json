                {
                  "evidence_id": "E00014",
                  "quote": "aci = entry.get('aci')"
                }
              ]
            },
            {
              "aspect": "filter",
              "description": "ac_match 在 account_type 为 null 时为 True，在列表包含 'R' 时为 True；aci_match 在 aci 为 null 时为 True，在列表包含 'B' 时为 True；两者同时成立才收集 ID。该版本没有 else 分支，非列表的标量值不会匹配。",
              "basis": "explicit",
              "evidence": [
                {
                  "evidence_id": "E00014",
                  "quote": "if ac is None:\n        ac_match = True  # null means all\n    elif isinstance(ac, list):\n        if 'R' in ac:\n            ac_match = True"
                },
                {
                  "evidence_id": "E00014",
                  "quote": "if aci is None:\n        aci_match = True  # null means all\n    elif isinstance(aci, list):\n        if 'B' in aci:\n            aci_match = True"
