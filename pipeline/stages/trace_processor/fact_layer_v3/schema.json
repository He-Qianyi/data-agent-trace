{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:data-agent-research:fact-layer:v1",
  "title": "Data Agent deterministic fact layer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_metadata", "task", "data_resources", "steps", "script_revisions", "model_exchanges", "generated_calls_without_observed_submission", "native_internal_tool_records", "deliverables", "final_response", "evaluation", "sources", "quality"],
  "properties": {
    "schema_version": {"const": "data-agent-fact-layer-v1"},
    "trace_metadata": {"type": "object", "required": ["record_id", "adapter", "recording_level", "ordering"]},
    "task": {"type": "object", "required": ["instruction", "instruction_ref", "metadata_as_recorded", "metadata_ref"]},
    "data_resources": {"type": "array", "items": {"type": "object", "required": ["basis"]}},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "script_revisions": {"type": "array", "items": {"type": "object", "required": ["revision_id", "step_ref", "status", "content", "runtime_file_hash_certified"], "properties": {"runtime_file_hash_certified": {"const": false}}}},
    "model_exchanges": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["exchange_id", "request_ref", "response_ref", "record_ref", "tool_call_ids"], "properties": {"request_ref": {"$ref": "#/$defs/ref"}, "response_ref": {"$ref": "#/$defs/ref"}, "record_ref": {"$ref": "#/$defs/ref"}, "tool_call_ids": {"type": "array", "items": {"type": "string"}}}}},
    "generated_calls_without_observed_submission": {"type": "array"},
    "native_internal_tool_records": {"type": "array"},
    "deliverables": {"type": "array", "items": {"type": "object", "required": ["artifact_id", "path_as_recorded", "evidence", "snapshot", "agent_creation_certified"], "properties": {"agent_creation_certified": {"const": false}, "snapshot": {"type": "object", "required": ["availability", "time_scope"], "properties": {"time_scope": {"const": "post_run_current_snapshot"}}}}}},
    "final_response": {"type": "object", "required": ["text", "source_ref", "selection_basis"], "properties": {"text": {"type": ["string", "null"]}}},
    "evaluation": {"type": "object", "required": ["records", "recomputed"], "properties": {"recomputed": {"const": false}, "records": {"type": "array", "items": {"type": "object", "required": ["payload", "source_ref", "available_to_agent"], "properties": {"source_ref": {"$ref": "#/$defs/ref"}, "available_to_agent": {"const": false}}}}}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["source_id", "path", "roles", "exists"], "properties": {"source_id": {"type": "string"}, "path": {"type": "string"}, "roles": {"type": "array", "minItems": 1}, "exists": {"type": "boolean"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}},
    "quality": {"type": "object", "required": ["status", "capture_check", "semantic_annotation_run", "source_reference_validation", "warnings"], "properties": {"status": {"enum": ["passed", "passed_with_warnings"]}, "semantic_annotation_run": {"const": false}, "source_reference_validation": {"const": "passed"}}}
  },
  "$defs": {
    "ref": {"type": "object", "required": ["source_id", "json_pointer"], "properties": {"source_id": {"type": "string"}, "json_pointer": {"type": "string"}, "line": {"type": "integer", "minimum": 1}, "char_start": {"type": "integer", "minimum": 0}, "char_end": {"type": "integer", "minimum": 0}, "decode_json_string": {"type": "boolean"}, "decoded_pointer": {"type": "string"}}},
    "step": {
      "type": "object",
      "required": ["step_id", "model_exchange_ref", "tool_call_id", "action", "observation", "artifact_refs", "annotations"],
      "properties": {
        "step_id": {"type": "string", "pattern": "^S[0-9]{4,}$"},
        "model_exchange_ref": {"type": "string"},
        "tool_call_id": {"type": "string"},
        "action": {"type": "object", "required": ["tool_name", "arguments_raw", "arguments", "arguments_ref", "static_extraction"], "properties": {"arguments_ref": {"$ref": "#/$defs/ref"}, "static_extraction": {"type": "object", "required": ["code_units", "file_actions", "script_invocations", "data_operations", "extraction_status"], "properties": {"code_units": {"type": "array"}, "file_actions": {"type": "array"}, "script_invocations": {"type": "array"}, "data_operations": {"type": "array"}}}}},
        "observation": {"type": "object", "required": ["variants", "preferred_variant", "availability", "exit_code_as_recorded", "is_error_as_recorded", "tool_status_as_recorded", "truncation"], "properties": {"availability": {"const": "recorded"}, "variants": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind", "payload", "source_ref"], "properties": {"source_ref": {"$ref": "#/$defs/ref"}, "kind": {"enum": ["native_tool_result", "framework_tool_result", "model_request_replay"]}}}}, "exit_code_as_recorded": {"type": ["integer", "null"]}, "is_error_as_recorded": {"type": ["boolean", "null"]}}},
        "artifact_refs": {"type": "array", "items": {"type": "string"}},
        "annotations": {"type": "object", "required": ["status"], "additionalProperties": false, "properties": {"status": {"const": "not_run"}}}
      }
    }
  }
}
